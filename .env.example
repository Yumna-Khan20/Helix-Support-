# =================================================================
# Helix Support Environment Variables
# All services used here have 100% FREE tiers available.
# =================================================================

# Server Port
PORT=3000

# 1. Google Gemini API Key (Free tier: 15 RPM / 1M TPM)
# Get yours here: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Postgres Database (Free tier: 500MB DB / 50,000 MAU)
# Create a free project here: https://supabase.com
# Find these in: Project Settings -> API -> Project URL & anon/service_role API Key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# 3. Discord Webhook URL (100% Free notifications)
# In Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# 4. Admin Dashboard Access Password
# Use this password to log into /admin.html and view/resolve tickets
ADMIN_PASSWORD=admin123
